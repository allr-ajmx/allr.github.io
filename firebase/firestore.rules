rules_version = '2';

// Deployed by .github/workflows/deploy-firestore-rules.yml on every push to
// main that touches this file — this is the live rule set, not a copy of it.
//
// Waitlist: the website may add one document per email; nobody can read,
// list, change or delete from the browser.
//
// Accounts: a signed-in person may read and write their own `users/{uid}`
// document and no one else's, and may never list the collection.
//
// Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['email', 'source', 'createdAt', 'userAgent'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 6
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 64
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 512
        // client clock, but must be within five minutes of server time
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(5, 'm')
        && request.resource.data.createdAt < request.time + duration.value(5, 'm');
      allow read, update, delete: if false;
    }
    // Mobile closed beta: same shape as the waitlist, plus which platform the
    // person wants. A separate collection so someone already on the main
    // waitlist can still join the beta (both use the email hash as the id).
    match /beta_signups/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['email', 'source', 'createdAt', 'userAgent', 'platform'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 6
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 64
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 512
        && request.resource.data.platform in ['android', 'ios', 'either']
        // client clock, but must be within five minutes of server time
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(5, 'm')
        && request.resource.data.createdAt < request.time + duration.value(5, 'm');
      allow read, update, delete: if false;
    }

    // Accounts. One document per signed-in person, keyed by their Firebase Auth
    // uid — which is what lets these rules say "only your own" without a query.
    //
    // The site is a static export: there is no server between the browser and
    // this database, so everything the registration form promises has to be
    // true here too, or it is not true at all.
    match /users/{uid} {
      function signedInAs(id) {
        return request.auth != null
          && request.auth.uid == id
          // Google always verifies. Checking it anyway means the email below is
          // an address the person demonstrably controls, not one they typed.
          && request.auth.token.email_verified == true;
      }

      // Allr is strictly an above-contract-age product (DESIGN.md §16).
      //
      // Rules have durations, not a calendar, so this cannot be exact: 18 years
      // is 6574 or 6575 days depending on the leap days in between. 6570 is
      // deliberately a few days loose, because being refused on the morning of
      // your eighteenth birthday is a real failure and four days of slack is
      // not. The exact calendar check is `isOldEnough()` in
      // src/lib/firebase/profile.ts; this is the backstop for a client that
      // never ran it.
      function oldEnough(dob) {
        return dob is timestamp
          && dob < request.time - duration.value(6570, 'd')
          && dob > request.time - duration.value(54750, 'd'); // ~150 years
      }

      // Client clocks are wrong; server timestamps resolve to request.time.
      // Either is fine, five minutes out is not.
      function fresh(ts) {
        return ts is timestamp
          && ts > request.time - duration.value(5, 'm')
          && ts < request.time + duration.value(5, 'm');
      }

      function validProfile(d, id) {
        return d.keys().hasOnly([
            'uid', 'email', 'legalName', 'dateOfBirth', 'country',
            'accountType', 'entityName', 'marketingOptIn',
            'termsVersion', 'privacyVersion', 'createdAt', 'updatedAt'
          ])
          && d.keys().hasAll([
            'uid', 'email', 'legalName', 'dateOfBirth', 'country',
            'accountType', 'entityName', 'marketingOptIn',
            'termsVersion', 'privacyVersion', 'createdAt', 'updatedAt'
          ])
          && d.uid == id
          && d.email is string
          && d.email == request.auth.token.email.lower()
          && d.legalName is string
          && d.legalName.size() >= 2
          && d.legalName.size() <= 120
          && d.country is string
          && d.country.matches('^[A-Z]{2}$')
          && d.accountType in ['individual', 'business']
          && d.entityName is string
          && d.entityName.size() <= 200
          // A business has a registered name; an individual has none, rather
          // than a leftover one from before they switched.
          && (d.accountType == 'business'
                ? d.entityName.size() >= 1
                : d.entityName == '')
          && d.marketingOptIn is bool
          // Consent is a required detail, not an optional one: a profile that
          // records no version of what was agreed to is a profile with no
          // consent behind it. The form disables its button until both are
          // ticked; this is what makes that true for anything that is not the
          // form.
          && d.termsVersion is string
          && d.termsVersion.size() >= 1
          && d.termsVersion.size() <= 32
          && d.privacyVersion is string
          && d.privacyVersion.size() >= 1
          && d.privacyVersion.size() <= 32
          && oldEnough(d.dateOfBirth)
          && fresh(d.updatedAt);
      }

      // Your own, and only ever one at a time: `list` is never allowed, so the
      // collection cannot be enumerated from a browser.
      allow get: if signedInAs(uid);
      allow list: if false;

      // `resource == null` says out loud that this branch is for a document
      // that does not exist yet — the emulator evaluates both branches for
      // every write, and this is what keeps the two readable side by side.
      //
      // The emulator logs an "evaluation error" for whichever branch does not
      // apply (an update has no `resource` to compare against, a create has
      // nothing to merge into). That is expected and it is fail-closed: an
      // erroring rule denies. The branch that applies is evaluated cleanly,
      // which is what rules.test.mjs pins down.
      allow create: if resource == null
        && signedInAs(uid)
        && validProfile(request.resource.data, uid)
        && fresh(request.resource.data.createdAt)
        && request.resource.data.createdAt == request.resource.data.updatedAt;

      // Identity is set once. The date of birth may be corrected — a typo
      // should not need a support desk — but only to another date that still
      // passes the age check, so nobody can edit themselves into being a minor.
      allow update: if resource != null
        && signedInAs(uid)
        && validProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;

      // Deleting an account is not a thing a form does on its own yet.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
