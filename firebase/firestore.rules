rules_version = '2';

// Deployed by .github/workflows/deploy-firestore-rules.yml on every push to
// main that touches this file — this is the live rule set, not a copy of it.
//
// Waitlist: the website may add one document per email; nobody can read,
// list, change or delete from the browser.
//
// Accounts: a signed-in person may read and write their own `users/{uid}`
// document and no one else's, and may never list the collection.
//
// Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['email', 'source', 'createdAt', 'userAgent'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 6
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 64
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 512
        // client clock, but must be within five minutes of server time
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(5, 'm')
        && request.resource.data.createdAt < request.time + duration.value(5, 'm');
      allow read, update, delete: if false;
    }
    // Mobile closed beta: same shape as the waitlist, plus which platform the
    // person wants. A separate collection so someone already on the main
    // waitlist can still join the beta (both use the email hash as the id).
    match /beta_signups/{id} {
      allow create: if
        request.resource.data.keys().hasOnly(['email', 'source', 'createdAt', 'userAgent', 'platform'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 6
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 64
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 512
        && request.resource.data.platform in ['android', 'ios', 'either']
        // client clock, but must be within five minutes of server time
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(5, 'm')
        && request.resource.data.createdAt < request.time + duration.value(5, 'm');
      allow read, update, delete: if false;
    }

    // Accounts.
    //
    // The browser cannot write here at all. Profiles are created and changed by
    // `src/app/api/account/**` through the Admin SDK, which bypasses these rules
    // entirely — so denying every client write costs the application nothing and
    // removes the last path to an account we did not make.
    //
    // That is what makes two things true. One account per email address: the
    // claim in `user_emails` is written in the same transaction as the profile,
    // and no client can write either. And approval that is not self-service:
    // `workspace_username`, `workspace_email` and `workspace_address` decide
    // whether somebody has access, and the person they describe cannot touch
    // them.
    match /users/{uid} {
      // Your own, one document at a time. `list` is never allowed, so the
      // collection cannot be enumerated from a browser.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;

      // What the workspace has published for this person. A subcollection
      // rather than an array on the profile: the list only grows, a document
      // caps at 1 MiB, and an array is rewritten whole on every publish.
      match /urls/{urlId} {
        allow get, list: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // The email claim index — one document per address, keyed by its SHA-256 so
    // the collection is not a mailing list. Server-only in both directions:
    // reading it would confirm whether an address has an account.
    match /user_emails/{hash} {
      allow read, write: if false;
    }

    // App versions and download links. Public to read, because /download and
    // /app render them for anyone; written by an admin, so a bad release is
    // rolled back by pointing currentVersion at an older version document.
    match /app_configuration/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
