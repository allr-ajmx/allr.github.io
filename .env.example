# Waitlist backend. Copy to .env.local for `next dev`; set the same values in
# GitHub Actions secrets (FIREBASE_PROJECT_ID / FIREBASE_API_KEY) and in the
# Vercel project's environment variables. See firebase/README.md.
#
# These are NEXT_PUBLIC_ and end up in the browser bundle by design — the
# Firestore rules in firebase/firestore.rules are the security boundary.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=

# Optional fallbacks, only used when the Firebase pair above is absent.
# A JSON endpoint that receives { email, source, list, collection, platform }.
# NEXT_PUBLIC_WAITLIST_URL=
# An address for formsubmit.co. Cannot detect duplicates.
# NEXT_PUBLIC_WAITLIST_EMAIL=

# Canonical site URL for Open Graph, Twitter cards and the sitemap.
# NEXT_PUBLIC_SITE_URL=
