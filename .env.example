# Waitlist backend. Copy to .env.local for `next dev`; set the same values in
# GitHub Actions secrets (FIREBASE_PROJECT_ID / FIREBASE_API_KEY) and in the
# Vercel project's environment variables. See firebase/README.md.
#
# These are NEXT_PUBLIC_ and end up in the browser bundle by design — the
# Firestore rules in firebase/firestore.rules are the security boundary.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=

# Google sign-in and the /account area use the same project. Firebase hosts the
# OAuth handshake on this domain; leave it blank and it is derived as
# ${NEXT_PUBLIC_FIREBASE_PROJECT_ID}.firebaseapp.com, which is almost always right.
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# Set to 1 to point both Auth and Firestore — including the waitlist forms — at
# the local emulator suite. `pnpm dev:emulated` sets this for you; you should
# never set it in a deployed build.
# NEXT_PUBLIC_FIREBASE_EMULATOR=

# Optional fallbacks, only used when the Firebase pair above is absent.
# A JSON endpoint that receives { email, source, list, collection, platform }.
# NEXT_PUBLIC_WAITLIST_URL=
# An address for formsubmit.co. Cannot detect duplicates.
# NEXT_PUBLIC_WAITLIST_EMAIL=

# Canonical site URL for Open Graph, Twitter cards and the sitemap.
# NEXT_PUBLIC_SITE_URL=

# The privileged server half. Paste the whole service-account JSON key, from
# Firebase console → Project settings → Service accounts → Generate new private
# key (the `firebase-adminsdk-…` account). NOT the key the rules workflow uses:
# that account holds only Firebase Rules Admin and cannot read a document.
# Without it the account API cannot create profiles, and says so rather than
# throwing. Set this in Vercel for Production AND Preview, never in the repo,
# and redeploy — Vercel reads environment variables at deploy time.
# FIREBASE_SERVICE_ACCOUNT=

# Only needed if the server should use a different project than the browser.
# FIREBASE_PROJECT_ID=
